* {
  box-sizing: border-box;
}
html,
body {
  margin: 0;
  padding: 0;
  background: #f3f5f7;
  color: #18222d;
  font-family: Inter, Arial, Helvetica, sans-serif;
}
button,
input,
textarea,
select {
  font: inherit;
}
button {
  cursor: pointer;
}
.loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  color: #66717d;
}
.topbar {
  height: 76px;
  background: #0f2633;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  position: sticky;
  top: 0;
  z-index: 20;
  box-shadow: 0 3px 15px #0002;
}
.brand {
  font-size: 20px;
  font-weight: 900;
  letter-spacing: 1px;
}
.brand small {
  display: block;
  font-size: 9px;
  letter-spacing: 1.2px;
  color: #b8d2dc;
  margin-top: 3px;
}
.topbar nav {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.topbar nav button {
  border: 0;
  background: transparent;
  color: #d6e0e5;
  padding: 9px 11px;
  border-radius: 7px;
  font-size: 12px;
}
.topbar nav button.active,
.topbar nav button:hover {
  background: #1e4455;
  color: #fff;
}
.page {
  max-width: 1420px;
  margin: auto;
  padding: 30px;
}
.hero {
  background: linear-gradient(135deg, #0f2633, #1d4c5c);
  color: white;
  border-radius: 18px;
  padding: 38px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
}
.hero h1 {
  font-size: 38px;
  margin: 5px 0 10px;
}
.hero p:not(.eyebrow) {
  max-width: 620px;
  color: #d7e6eb;
}
.eyebrow {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: #66818c;
  margin: 0 0 7px;
}
.hero .eyebrow {
  color: #9fc3ce;
}
.primary {
  border: 0;
  background: #0f2633;
  color: #fff;
  border-radius: 7px;
  padding: 10px 15px;
  font-weight: 800;
}
.big {
  padding: 14px 18px;
  background: #fff;
  color: #0f2633;
}
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 18px 0;
}
.stat,
.panel,
.table-card,
.customer-card,
.product-add {
  background: #fff;
  border: 1px solid #dde3e7;
  border-radius: 12px;
}
.stat {
  padding: 18px;
}
.stat span {
  display: block;
  color: #71808a;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.stat b {
  display: block;
  font-size: 23px;
  margin-top: 7px;
}
.dash-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 15px;
}
.panel {
  padding: 18px;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #edf0f2;
  padding-bottom: 12px;
  margin-bottom: 4px;
}
.panel-head h2 {
  font-size: 15px;
  margin: 0;
}
.panel-head span {
  font-size: 11px;
  color: #78838c;
}
.recent {
  display: flex;
  width: 100%;
  justify-content: space-between;
  text-align: left;
  border: 0;
  border-bottom: 1px solid #edf0f2;
  background: #fff;
  padding: 13px 3px;
}
.recent span {
  display: grid;
  gap: 3px;
}
.recent small {
  color: #7a858d;
}
.workflow {
  margin: 0;
  padding: 8px 0 8px 25px;
  line-height: 2.5;
  color: #47535c;
}
.billing-layout {
  display: grid;
  grid-template-columns: 310px 1fr;
  max-width: 1500px;
  margin: auto;
}
.controls {
  padding: 20px;
}
.control-card {
  background: #fff;
  border: 1px solid #dce3e7;
  border-radius: 12px;
  padding: 18px;
  position: sticky;
  top: 96px;
}
.control-card h3 {
  font-size: 11px;
  margin: 16px 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #68757e;
}
.seg {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.seg button {
  border: 1px solid #d7dee3;
  background: #fff;
  border-radius: 7px;
  padding: 9px;
  font-size: 12px;
}
.seg button.selected {
  background: #0f2633;
  color: #fff;
  border-color: #0f2633;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin: 9px 0;
}
.field span {
  font-size: 10px;
  font-weight: 800;
  color: #63717b;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.field input,
.field textarea,
.field select,
.toolbar input {
  width: 100%;
  border: 1px solid #d6dee3;
  border-radius: 6px;
  padding: 8px 9px;
  background: #fff;
  outline: none;
}
.field textarea {
  min-height: 60px;
  resize: vertical;
}
.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: #5f8391;
}
.actions {
  display: grid;
  gap: 8px;
  margin-top: 18px;
}
.actions button {
  border: 0;
  background: #e9eef1;
  border-radius: 7px;
  padding: 10px;
  font-weight: 700;
}
.actions .primary {
  background: #0f2633;
}
.editor {
  padding: 25px 24px 70px;
}
.editor-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 15px;
}
.editor-head h2 {
  margin: 0;
}
.editor-head > span {
  font-size: 11px;
  color: #73808a;
}
.party,
.items-editor {
  background: #fff;
  border: 1px solid #dce3e7;
  border-radius: 10px;
  margin-bottom: 14px;
  overflow: hidden;
}
.section-title {
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 11px 13px;
  background: #f4f7f8;
  border-bottom: 1px solid #e1e6e9;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 14px;
  padding: 8px 13px;
}
.full {
  grid-column: 1/-1;
}
.save-mini {
  margin: 0 13px 13px;
  border: 0;
  background: #edf3f5;
  color: #164252;
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 800;
}
.item-head,
.item-row {
  display: grid;
  grid-template-columns: 28px minmax(250px, 2fr) 90px 62px 66px 95px 65px 32px;
  gap: 6px;
  align-items: center;
  padding: 8px 10px;
}
.item-head {
  font-size: 9px;
  font-weight: 900;
  color: #697680;
  background: #fafbfb;
  border-bottom: 1px solid #e5e9eb;
}
.item-row {
  border-bottom: 1px solid #edf0f2;
}
.item-row input,
.item-row select {
  width: 100%;
  min-width: 0;
  border: 1px solid #d6dee3;
  border-radius: 5px;
  padding: 7px;
}
.product-cell {
  display: grid;
  gap: 4px;
}
.danger {
  border: 0;
  background: #fff0f0;
  color: #b42318;
  border-radius: 5px;
  padding: 6px;
}
.add {
  margin: 10px;
  border: 1px dashed #9fb1ba;
  background: #fff;
  padding: 8px 12px;
  border-radius: 6px;
  font-weight: 700;
  color: #36535e;
}
.item-total {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto;
  gap: 10px;
  padding: 13px;
  border-top: 1px solid #e1e6e9;
  background: #fafcfc;
}
.item-total span {
  font-size: 10px;
  color: #6d7981;
}
.item-total b {
  font-size: 12px;
}
.extra-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.page-title {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 18px;
}
.page-title h1,
.settings h1 {
  margin: 0;
}
.page-title p,
.muted {
  color: #6f7b84;
  font-size: 13px;
}
.toolbar {
  margin-bottom: 12px;
}
.toolbar input {
  max-width: 400px;
}
.table-card {
  overflow: auto;
}
.table-card table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.table-card th,
.table-card td {
  padding: 11px;
  border-bottom: 1px solid #edf0f2;
  text-align: left;
  white-space: nowrap;
}
.table-card th {
  font-size: 10px;
  text-transform: uppercase;
  color: #6b7881;
  background: #f8fafb;
}
.table-card button {
  border: 0;
  background: #e9eef1;
  padding: 6px 9px;
  border-radius: 5px;
  margin-right: 5px;
}
.table-card input {
  border: 1px solid #d9e0e4;
  border-radius: 5px;
  padding: 6px;
  max-width: 160px;
}
.status {
  background: #edf5f1;
  color: #276349;
  border-radius: 20px;
  padding: 4px 8px;
  font-size: 10px;
}
.product-add,
.customer-form {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1fr auto;
  gap: 8px;
  padding: 14px;
  margin-bottom: 14px;
  align-items: end;
}
.product-add .field,
.customer-form .field {
  margin: 0;
}
.customer-form {
  grid-template-columns: 1fr 1fr 1fr 1fr 90px;
}
.customer-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.customer-card {
  padding: 15px;
  display: grid;
  gap: 6px;
}
.customer-card span,
.customer-card small {
  color: #71808a;
  font-size: 11px;
}
.customer-card button {
  margin-top: 7px;
  margin-right: 5px;
}
.settings {
  max-width: 1100px;
}
.settings-grid {
  background: #fff;
  border: 1px solid #dde3e7;
  border-radius: 12px;
  padding: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px 20px;
}
.empty {
  background: #fff;
  border: 1px dashed #c8d0d8;
  border-radius: 10px;
  padding: 40px;
  text-align: center;
  color: #6b7780;
}
.print-area {
  position: fixed;
  left: -100000px;
  top: 0;
}
.invoice {
  width: 190mm;
  min-height: 277mm;
  background: #fff;
  color: #111;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 9.5px;
  border: 1px solid #111;
}
.invoice-top {
  height: 13mm;
  border-bottom: 1px solid #111;
  text-align: center;
  position: relative;
  padding-top: 5px;
  font-size: 14px;
}
.invoice-top span {
  position: absolute;
  right: 5px;
  bottom: 4px;
  font-size: 9px;
  font-weight: normal;
}
.invoice-head {
  display: grid;
  grid-template-columns: 43% 57%;
  min-height: 73mm;
}
.seller {
  border-right: 1px solid #111;
  padding: 4px;
  line-height: 1.35;
}
.seller-brand {
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 1px;
}
.seller hr {
  border: 0;
  border-top: 1px solid #111;
  margin: 4px 0;
}
.party-print {
  margin-top: 2px;
}
.meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.meta-row {
  border-bottom: 1px solid #111;
  border-left: 0;
  padding: 3px 5px;
  min-height: 8mm;
}
.meta-row:nth-child(odd) {
  border-right: 1px solid #111;
}
.meta-row span {
  display: block;
  font-size: 8px;
}
.meta-row b {
  font-size: 9px;
}
.meta-row.large {
  grid-column: 1/-1;
  min-height: 12mm;
}
.invoice-table {
  width: 100%;
  border-collapse: collapse;
}
.invoice-table th,
.invoice-table td {
  border: 1px solid #111;
  padding: 3px;
  text-align: right;
  vertical-align: top;
}
.invoice-table th:nth-child(2),
.invoice-table td:nth-child(2) {
  text-align: left;
}
.invoice-table th {
  font-size: 8px;
}
.invoice-table td {
  height: 5mm;
}
.invoice-table .spacer td {
  height: 38mm;
}
.invoice-table .right {
  text-align: right;
}
.invoice-table .grand td {
  font-weight: 900;
}
.invoice-bottom {
  display: grid;
  grid-template-columns: 55% 45%;
  min-height: 30mm;
}
.invoice-bottom > div {
  border: 1px solid #111;
  border-top: 0;
  padding: 5px;
}
.declaration {
  display: grid;
  grid-template-columns: 65% 35%;
  min-height: 27mm;
}
.declaration > div {
  border: 1px solid #111;
  border-top: 0;
  padding: 5px;
}
.declaration .sign {
  text-align: right;
}
.footer {
  text-align: center;
  border: 1px solid #111;
  border-top: 0;
  padding: 4px;
  font-size: 8px;
}
@media (max-width: 1100px) {
  .topbar {
    height: auto;
    align-items: flex-start;
    gap: 12px;
    flex-direction: column;
    padding: 15px;
  }
  .billing-layout {
    grid-template-columns: 1fr;
  }
  .controls {
    padding: 15px;
  }
  .control-card {
    position: static;
  }
  .stats {
    grid-template-columns: 1fr 1fr;
  }
  .dash-grid,
  .customer-grid {
    grid-template-columns: 1fr;
  }
  .item-head,
  .item-row {
    grid-template-columns: 25px minmax(190px, 2fr) 75px 55px 55px 80px 55px 28px;
  }
  .product-add,
  .customer-form {
    grid-template-columns: 1fr 1fr;
  }
  .hero {
    flex-direction: column;
    align-items: flex-start;
  }
}
@media print {
  @page {
    size: A4;
    margin: 0;
  }
  html,
  body {
    background: #fff !important;
  }
  .topbar,
  .page,
  .billing-layout,
  .print-area {
    display: none !important;
  }
  .print-area {
    position: static !important;
    display: block !important;
  }
  .invoice {
    width: 190mm;
    min-height: 277mm;
    border: 1px solid #111;
    margin: 0 auto;
  }
}

/* Billing UX refinements */
.party-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.same-check {
  display: flex;
  align-items: center;
  gap: 7px;
  text-transform: none;
  letter-spacing: 0;
  font-size: 11px;
  font-weight: 800;
  color: #31515d;
  cursor: pointer;
}
.same-check input {
  width: 15px;
  height: 15px;
}
.linked-party .grid2 {
  opacity: 0.72;
}
.linked-party .grid2 input,
.linked-party .grid2 textarea,
.linked-party .grid2 select {
  background: #f3f6f7;
  cursor: not-allowed;
}
.linked-party .grid2 {
  pointer-events: none;
}
.party-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 13px 13px;
}
.party-actions .save-mini {
  margin: 0;
}
.same-note {
  font-size: 10px;
  color: #60747d;
  font-weight: 700;
}
.meta-row {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
  min-height: 10mm;
  padding: 4px 6px;
}
.meta-row span {
  font-weight: 700;
  line-height: 1.1;
}
.meta-row b {
  display: block;
  min-height: 11px;
  line-height: 1.2;
  word-break: break-word;
}
.meta-row.large {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 14mm;
}
.table-card td:last-child {
  min-width: 135px;
}

/* Deal Magsil A4 refinements */
.terms-editor {
  background: #fff;
  border: 1px solid #dce3e7;
  border-radius: 10px;
  margin-top: 14px;
  overflow: hidden;
}
.optional-label {
  font-weight: 600;
  color: #7a8790;
  margin-left: 6px;
  text-transform: none;
  letter-spacing: 0;
}
.terms-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 14px;
  padding: 8px 13px 12px;
}
.terms-fields .field {
  margin: 6px 0;
}
.stamp-setting {
  border: 1px dashed #cbd5da;
  border-radius: 8px;
  padding: 14px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  align-items: center;
  margin-top: 8px;
}
.stamp-setting p {
  margin: 5px 0 0;
  color: #71808a;
  font-size: 11px;
  line-height: 1.5;
}
.stamp-preview-setting {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.stamp-preview-setting img {
  width: 150px;
  height: 90px;
  object-fit: contain;
  border: 1px solid #e0e5e8;
  border-radius: 6px;
  background: #fff;
}
.invoice-terms {
  border: 1px solid #111;
  border-top: 0;
  padding: 5px 7px;
  font-size: 8.5px;
  line-height: 1.35;
  min-height: 12mm;
}
.invoice-terms ul {
  margin: 3px 0 0;
  padding-left: 18px;
}
.invoice-terms li {
  margin: 1px 0;
}
.stamp-image {
  display: block;
  width: 75px;
  height: 55px;
  object-fit: contain;
  margin: 3px auto 0;
}
.stamp-placeholder {
  width: 75px;
  height: 55px;
  border: 1px dashed #777;
  display: grid;
  place-items: center;
  margin: 3px auto 0;
  font-size: 7px;
  color: #666;
  text-transform: uppercase;
}
.meta-row span,
.meta-row b {
  display: block !important;
}
.meta-row span {
  font-size: 8px !important;
  font-weight: 700 !important;
  white-space: normal;
}
.meta-row b {
  font-size: 9px !important;
  min-height: 12px !important;
  line-height: 1.25 !important;
  margin-top: 2px;
}
@media print {
  .invoice {
    font-size: 9px;
    min-height: 277mm;
    overflow: hidden;
  }
  .invoice-top {
    height: 11mm;
    padding-top: 4px;
  }
  .invoice-head {
    min-height: 69mm;
  }
  .meta-row {
    min-height: 8.2mm;
    padding: 3px 5px;
  }
  .meta-row.large {
    min-height: 11mm;
  }
  .invoice-table .spacer td {
    height: 30mm;
  }
  .invoice-bottom {
    min-height: 27mm;
  }
  .invoice-terms {
    min-height: 11mm;
  }
  .declaration {
    min-height: 24mm;
  }
  .stamp-image,
  .stamp-placeholder {
    width: 70px;
    height: 50px;
  }
}
@media (max-width: 900px) {
  .terms-fields,
  .stamp-setting {
    grid-template-columns: 1fr;
  }
  .meta {
    grid-template-columns: 1fr 1fr;
  }
}
.drive-setting {
  border: 1px solid #dce3e7;
  border-radius: 10px;
  background: #f8fafb;
  padding: 16px;
  margin-top: 8px;
  display: grid;
  gap: 10px;
}
.drive-setting p {
  margin: 4px 0 0;
  color: #6f7b84;
  font-size: 11px;
  line-height: 1.55;
}
.drive-setting code {
  background: #edf2f4;
  padding: 2px 4px;
  border-radius: 4px;
}
.drive-status {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  font-size: 11px;
  font-weight: 700;
  color: #355b68;
}
.drive-note {
  font-size: 10px !important;
}
.drive-message {
  margin: 0;
  color: #355b68;
  font-size: 11px;
  font-weight: 700;
}
.secondary {
  border: 1px solid #cfd9de;
  background: #fff;
  color: #244b59;
  border-radius: 6px;
  padding: 7px 10px;
  font-weight: 700;
}
.secondary:disabled,
.primary:disabled,
.danger:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* Advanced dashboard */
.dashboard-filter {
  margin: 18px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 14px 18px;
}
.filter-caption {
  display: block;
  color: #74818a;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 800;
  margin-bottom: 4px;
}
.dashboard-filter > b {
  font-size: 14px;
}
.range-tabs {
  display: flex;
  gap: 5px;
}
.range-tabs button {
  border: 1px solid #d5dee3;
  background: #fff;
  color: #53626b;
  border-radius: 7px;
  padding: 8px 14px;
  font-size: 11px;
  font-weight: 800;
}
.range-tabs button.selected {
  background: #0f2633;
  color: #fff;
  border-color: #0f2633;
}
.dashboard-charts {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 15px;
  margin-bottom: 15px;
}
.chart-panel {
  min-height: 300px;
}
.chart-panel .panel-head strong {
  font-size: 13px;
}
.sales-chart {
  height: 220px;
  display: flex;
  align-items: flex-end;
  gap: 6px;
  padding: 16px 6px 0;
  overflow: hidden;
}
.sales-column {
  height: 100%;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}
.sales-column > span {
  font-size: 9px;
  color: #71808a;
  white-space: nowrap;
}
.sales-value {
  height: 16px;
  font-size: 8px;
  color: #5d6b73;
  white-space: nowrap;
  overflow: hidden;
  max-width: 100%;
  text-overflow: ellipsis;
}
.sales-track {
  height: 175px;
  width: 100%;
  max-width: 32px;
  background: #edf2f4;
  border-radius: 6px 6px 2px 2px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.sales-bar {
  width: 100%;
  background: #1d596c;
  border-radius: 5px 5px 0 0;
  min-height: 0;
  transition: height 0.2s;
}
.sales-month .sales-column {
  min-width: 17px;
}
.sales-month .sales-track {
  max-width: 18px;
}
.sales-month .sales-value {
  font-size: 7px;
}
.sales-year .sales-track {
  max-width: 35px;
}
.sales-all .sales-track {
  max-width: 42px;
}
.item-chart {
  display: grid;
  gap: 17px;
  padding: 16px 3px;
}
.item-bar-row {
  display: grid;
  gap: 6px;
}
.item-bar-label {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 11px;
}
.item-bar-label span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #40515b;
}
.item-bar-label b {
  font-size: 11px;
}
.item-track {
  height: 10px;
  background: #edf2f4;
  border-radius: 20px;
  overflow: hidden;
}
.item-bar {
  height: 100%;
  background: #315f6e;
  border-radius: 20px;
  min-width: 3px;
}
.dashboard-page .empty {
  padding: 25px;
}
.dashboard-page .recent strong {
  white-space: nowrap;
}
@media (max-width: 1100px) {
  .dashboard-charts {
    grid-template-columns: 1fr;
  }
  .dashboard-filter {
    align-items: flex-start;
    flex-direction: column;
  }
  .range-tabs {
    width: 100%;
  }
  .range-tabs button {
    flex: 1;
  }
}

.login-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px;
  background: linear-gradient(135deg, #f6f7f9, #eef1f5);
}
.login-card {
  width: min(480px, 100%);
  background: #fff;
  border: 1px solid #dfe3e8;
  border-radius: 18px;
  padding: 30px;
  box-shadow: 0 18px 50px rgba(20, 30, 40, 0.1);
}
.login-brand {
  margin-bottom: 24px;
}
.login-card h1 {
  margin: 6px 0 10px;
}
.login-card .field {
  margin: 14px 0;
}
.login-card .primary {
  width: 100%;
  margin-top: 8px;
}
.login-note {
  font-size: 12px;
  color: #68727d;
  margin-top: 16px;
  line-height: 1.5;
}
.error-message,
.error-banner,
.login-error-banner {
  color: #9f1d1d;
  background: #fff1f1;
  border: 1px solid #f0c8c8;
  border-radius: 9px;
  padding: 10px 12px;
}
.error-banner {
  margin: 12px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.login-error-banner {
  position: fixed;
  left: 20px;
  right: 20px;
  bottom: 20px;
  z-index: 20;
}

/* Bill PDF preview modal */
.bill-preview-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(9, 20, 27, 0.72);
  display: flex;
  flex-direction: column;
}
.bill-preview-toolbar {
  flex: 0 0 auto;
  background: #0f2633;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 18px;
  box-shadow: 0 3px 18px rgba(0, 0, 0, 0.25);
}
.bill-preview-toolbar > div:first-child {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.bill-preview-toolbar span {
  font-size: 11px;
  color: #b9cbd2;
}
.bill-preview-actions {
  display: flex;
  gap: 8px;
}
.bill-preview-actions button {
  border: 0;
  border-radius: 7px;
  padding: 9px 13px;
  background: #e8eef1;
  color: #18313d;
  font-weight: 800;
}
.bill-preview-actions .primary {
  background: #fff;
  color: #0f2633;
}
.bill-preview-scroll {
  flex: 1;
  overflow: auto;
  padding: 24px;
}
.bill-preview-paper {
  width: 190mm;
  min-height: 277mm;
  margin: 0 auto;
  background: #fff;
  box-shadow: 0 10px 35px rgba(0, 0, 0, 0.28);
}
.bill-preview-paper .invoice {
  border: 1px solid #111;
}
.table-action {
  margin-right: 5px !important;
}
.actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  filter: grayscale(0.2);
}
@media (max-width: 900px) {
  .bill-preview-scroll {
    padding: 10px;
  }
  .bill-preview-paper {
    transform-origin: top left;
    width: 190mm;
  }
  .bill-preview-toolbar {
    align-items: flex-start;
  }
  .bill-preview-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }
}
